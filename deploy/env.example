# 서버의 $HOME/plink/plink-admin/<env>/.env 로 복사해서 쓴다.

# ── dev 예시 ──
COMPOSE_PROJECT_NAME=plink-admin-dev
APP_ENV=development
HOST_PORT=3101
EXTERNAL_API_URL=https://plink-api.funx.ai:8443

# ── prod 예시 ──
# COMPOSE_PROJECT_NAME=plink-admin-prod
# APP_ENV=production
# HOST_PORT=3100
# EXTERNAL_API_URL=https://plink-api.funx.ai

IMAGE=asia-northeast3-docker.pkg.dev/plink-510000/plink/plink-admin
# deploy/build-push.sh가 출력한 git sha 태그
TAG=<git-sha>
